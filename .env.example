# Copy this file to .env and fill in the values. The .env file is gitignored.
# Never commit real keys.

# NREL API key for the AFDC stations API. Request one at https://developer.nrel.gov/signup/
NREL_API_KEY=

# Census API key for the ACS API. Request one at https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Path to the user-downloaded SDG&E ICA grid layer. Gated behind a free SDG&E account.
# Defaults to data/raw/sdge_ica.geojson if unset.
SDGE_ICA_PATH=

# Base URL of the local OSRM car-profile instance. Defaults to http://localhost:5000 if unset.
OSRM_BASE_URL=http://localhost:5000
