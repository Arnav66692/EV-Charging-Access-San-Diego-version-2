# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
.env

# Raw data is input only. Nothing under data/raw is redistributable.
# The SDG&E ICA layer is gated and must never be committed. The directory is
# kept via its .gitkeep, but every real file in it is ignored.
data/raw/*
!data/raw/.gitkeep

# Large routing inputs and build artifacts.
*.osm.pbf
*.osrm
*.osrm.*
osrm-data/

# OS noise
.DS_Store

# Interim scratch may be large and can hold SDG&E derived geometry, which is
# input only.
data/interim/*
!data/interim/.gitkeep

# Snapshots are frozen for reproducibility but can be large, for example the SCE
# layer is tens of MB. The reproducibility record is the manifest under
# manifests/, which carries the sha256. Gitignore the large snapshot blobs.
# Keep the small committed sample fixtures the tests verify. Use git-lfs if these
# must be versioned.
data/snapshots/*
!data/snapshots/.gitkeep
!data/snapshots/*sample*

# Processed outputs are regenerable from the pipeline and some are large, for
# example the SCE grid parquet is tens of MB. Track the manifests, not the blobs.
data/processed/*.parquet
data/processed/*.csv
!data/processed/.gitkeep

# Run logs.
logs_*.txt

# SDG&E is input-only. Its manifest stays gitignored too, not just the data.
manifests/sdge_*
